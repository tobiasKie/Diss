\@writefile{lof}{\contentsline {figure}{\numberline {2.4}{\ignorespaces Optisches System: (a) zeigt beispielhaft eine Kamera für die Bewegungsanalyse. (b) zeigt einen optischen Marker, dessen Bewegung von einem Kamerasystem aufgenommen werden kann.}}{9}{figure.caption.19}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.2.2}Stand der Technik}{9}{subsection.2.2.2}\protected@file@percent }
