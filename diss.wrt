\@writefile{toc}{\contentsline {section}{\numberline {3.1}Modellierung magnetischer Felder}{15}{section.3.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1.1}Biot-Savart}{15}{subsection.3.1.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1.2}Magnetischer Dipol}{16}{subsection.3.1.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\nonumberline Herleitung des Dipolfeldes}{16}{subsubsection*.33}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.1}{\ignorespaces Berechnung des Magnetfeldes eines infinitisimal kleinen Leiterstücks: In rot ist eine Leiterschleife mit der Stromstärke $I$ zu sehen. Am Beobachtungspunkt $\vec {r}$ wird das resultierende Magnetfeld bestimmt. Beispielhaft wird dafür das Leiterstück innerhalb des schwarzen Rechtecks betrachtet. Der Pfeil darin gibt die Richtung des Stroms $d\vec {s}$ an. Der rote gestrichelte Pfeil zeigt $\vec {r}-\vec {r'}$. Am Beobachtungspunkt resultiert das differentielle Magnetfeld $d\,\vec {b}$.}}{17}{figure.caption.31}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\nonumberline Betrag eines Dipolfeldes}{18}{subsubsection*.35}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.2}{\ignorespaces Die Abbildung zeigt exemplarisch den Verlauf des Magnetfeldbetrags. In der Mitte (roter Pfeil) ist ein magnetischer Dipol in $y$-Richtung polarisiert. Die grüne Kurve zeigt beispielhaft den Verlauf von $r(b_{\textrm {\footnotesize \add@extra@listi {ftns}{Dip}}}=c,\phi )$.}}{19}{figure.caption.36}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.3}{\ignorespaces Äquibetragsfläche: In Blau ist die Oberfläche eines Rotationskörper dargestellt. Der Betrag ist so gewählt, dass bei $\phi = \frac {\pi }{2}$ der Abstand auf 1 normiert ist. Die Einheit ist irrelevant, da nur die Form des Körpers gezeigt werden soll.}}{19}{figure.caption.37}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1.3}Quasistationäre Felder}{20}{subsection.3.1.3}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {3.2}3D-Spule}{20}{section.3.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.4}{\ignorespaces 3D-Spule: (a) skizziert das modellierte Simulationsobjekt, wobei rot für die $x$-Spule, grün für die $y$-Spule und blau für die $z$-Spule steht. Ein Foto der entsprechenden Realisierung ist in (b) zu sehen.}}{20}{figure.caption.38}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.5}{\ignorespaces Frequenzabhängiger Impendanzverlauf einer der Spulen}}{21}{figure.caption.39}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {3.3}Sensormodellierung}{21}{section.3.3}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {3.4}Maximalvektor}{21}{section.3.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.4.1}Lokalisierungszusammenhänge}{22}{subsection.3.4.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\nonumberline Orientierung und normierte Position}{22}{subsubsection*.41}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.6}{\ignorespaces Verwendetes Setup für die Herleitung: $\vec {e}_{\textrm {\footnotesize \add@extra@listi {ftns}{r}}}$ und $\vec {e}_{\textrm {\footnotesize \add@extra@listi {ftns}{s}}}$ liegen beide in der $xy$-Ebene. $\phi _{\textrm {\footnotesize \add@extra@listi {ftns}{m}}}$ und $\theta _{\textrm {\footnotesize \add@extra@listi {ftns}{m}}}$ definieren die Richtung des rotierenden magnetischen Dipols $\vec {e}_{\textrm {\footnotesize \add@extra@listi {ftns}{m}}}$ in Kugelkoordinaten.}}{22}{figure.caption.42}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.7}{\ignorespaces Die Beziehung aus Gleichung\,\ref {eq:relMaxS} ist unabhängig vom Winkel $\phi $. Außerdem wird die eindeutige Beziehung zwischen den drei Einheitsvektoren gezeigt. Auf der linken Seite ist der Sensor auf der $x$-Achse lokalisiert, wie in der Herleitung. Auf der rechten Seite ist das Ganze Setup gedreht. $\phi _{\textrm {\footnotesize \add@extra@listi {ftns}{s}}}$ und $\phi _{\textrm {\footnotesize \add@extra@listi {ftns}{max}}}$ bleiben gleich, nur die Bezugsachse dreht sich mit.}}{24}{figure.caption.43}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.8}{\ignorespaces Potentielle Posen der Sensoren: In der Mitte ist ein MV in $y$-Richtung dargestellt. Die blauen Vektoren zeigen potentielle Posen, Positionen mit den zugehörigen Orientierungen. Der Anfang der Pfeile definiert die Position und die Richtung des Pfeils die zugehörige Orientierung.}}{25}{figure.caption.44}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\nonumberline Distanz zwischen Sensor und Quelle}{25}{subsubsection*.46}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {3.5}Zusammenfassung und Ausblick}{26}{section.3.5}\protected@file@percent }
\@writefile{toc}{\contentsline {chapter}{\numberline {4}Signalverarbeitungspipeline}{27}{chapter.4}\protected@file@percent }
\@writefile{lof}{\addvspace {10\p@ }}
\@writefile{lot}{\addvspace {10\p@ }}
\@writefile{lof}{\contentsline {figure}{\numberline {4.1}{\ignorespaces Überblick der Signalverarbeitungspipeline: Auf der linken Seite kommen die Strom- und Magnetfeldsignale als Spannungen an und werden mit einem AD-Wandler mit einer konstanten Abtastrate digitalisiert. Diese Signale werden zunächst in der Vorverarbeitung entzerrt und gefiltert. Die gefilterten Signale werden genutzt um spezifische Merkmale zu extrahieren. Die Merkmale werden an die Lokalisierung gegeben. Diese schätzen Positionen und Orientierungen und geben diese an die Nachverarbeitung weiter. Die geschätzten Positionen und Orientierungen können dann von beliebigen Anwendungen verwendet werden.}}{27}{figure.caption.47}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4.1}Vorverarbeitung}{28}{section.4.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces Übertragunsmechanismus: Eine Spannungsquelle erzeugt einen Strom durch die 3D-Spule. Die 3D-Spule erzeugt ein Magnetfeld, das von einem Fluxgatemagnetometer aufgenommen, in eine Spannung gewandelt und vom AD-Wandler digitalisiert. Der Spulenstrom kann als Spannungsabfall über $R_{\textrm {\footnotesize \add@extra@listi {ftns}{s}}}$ vom AD-Wandler gemessen werden.}}{28}{figure.caption.48}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.3}{\ignorespaces Vorverarbeitungsfilter: Auf der linken Seite ist der Tiefpassfilter zur Entzerrung des Stromsignals, auf der rechten Seite ist der Bandpassfilter zur Filterung von Störungen dargestellt.}}{30}{figure.caption.49}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.4}{\ignorespaces Signalflussgraph des Vorverarbeitungsmoduls: Strom- und Magnetfeldsignale werden mit einem Butterworth-Bandpassfilter gefiltert. Die Verzerrung des Magnetfeldsensors wird mit einem Tiefpassfilter auch auf das Stromsignal angewendet.}}{30}{figure.caption.50}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4.2}Signalgenerierung und Merkmalsextraktion}{31}{section.4.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2.1}Generierung eines zeitlich räumlich rotierendem Feld}{31}{subsection.4.2.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.5}{\ignorespaces Bahn des magnetischen Dipols $\vec m (t)$ mit Startpunkt im Ursprung als Funktion der Zeit. Die Spitze von $\vec m$ bewegt sich auf der Oberfläche einer Kugel mit Radius $m_0$ für $N_\omega =\omega _\theta / \omega _\phi = 10$.}}{31}{figure.caption.51}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2.2}Merkmalsextraktion}{32}{subsection.4.2.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\nonumberline Vektormerkmal}{32}{subsubsection*.53}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.6}{\ignorespaces Die linke Abbildung zeigt beispielhaft einen MV im Ursprung (gelb), die Position und Orientierung (orange) des Sensors und die entsprechende Ebene der Nulldurchgangsvektoren (lila). Auf der rechten Seite ist $b(n)$ als Funktion der Zeit dargestellt. Die Zeiten, in denen ein Nulldurchgang erreicht wird, sind mit einem lila Punkt markiert. Die Simulation arbeitet mit einer Quelle, die mit $N_\omega =\omega _\theta / \omega \phi = 10$ angesteuert wird. Die absoluten Werte/Längen sind nicht relevant, da zum einen das relative Verhältnis zwischen den Vektoren und zum anderen die Nulldurchgänge von Interesse sind.}}{33}{figure.caption.54}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\nonumberline Distanzmerkmal}{34}{subsubsection*.56}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\nonumberline Merkmalszusammenfassung}{35}{subsubsection*.58}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.7}{\ignorespaces Auswertung des Distanzmerkmal anhand eines Laborsignals: In (a) ist der Verlauf des Distanzmerkmals ohne Medianfilter dargestellt, zum Vergleich dazu ist in (b) der Verlauf mit Medianfilter dargestellt. Die Rahmenlänge beträgt 512.}}{36}{figure.caption.59}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.8}{\ignorespaces Überblick Merkmalsextraktion: Das Modul verarbeitet die Strom- und Magnetfeldsignale. Es wird $\vec {e}_{\textrm {\footnotesize \add@extra@listi {ftns}{max}}}$ bestimmt, und damit $g$. Die beiden Merkmale werden zum MV zusammengesetzt.}}{36}{figure.caption.60}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4.3}Lokalisierung}{37}{section.4.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3.1}Schätzung einer kinematischen Kette}{37}{subsection.4.3.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\nonumberline Iterativer Algorithmus}{37}{subsubsection*.63}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.9}{\ignorespaces Sensor- und Quellenanordnung: Die kinematische Kette besteht aus zylinderförmigen Element, sowie Gelenken die diese verbinden und die Möglichkeit haben diese zu bewegen. Die linke Seite zeigt die Anordnung der Quellen und Sensoren auf der kinematischen Kette. Auf dem ersten Element ist eine 3D-Spule angebracht. Die weiteren Elemente sind mit Sensoren ausgerüstet. Diese sind auf der Mittelachse des kinematischen Elements, außerdem ist die sensitive Achse des Sensors mit der Symetrieachse des Elements ausgerichtet (siehe rechter Teil). }}{38}{figure.caption.61}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.10}{\ignorespaces Flussdiagramm des iterativen Algorithmus: Der Algorithmus startet mit einer zufällig ausgewählten Sensororientierung. Im ersten Schritt wird die relative Sensorposition bestimmt. Daraus wird die zugehörige Sensororientierung bestimmt. Diese Prozedur wird wiederholt, bis die Veränderung zwischen den Iterationen kleiner ist als ein definierter Schwellenwert und Konvergenz erreicht ist. Diese Orientierung ist dann die geschätzte Lösung.}}{39}{figure.caption.64}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\nonumberline Eindeutigkeit der Lösung}{39}{subsubsection*.68}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.11}{\ignorespaces Beispielhafter iterativer Prozess: Diese Abbildung zeigt die Iterationen für einen einfachen Aufbau. Die Unterabbildung (a) zeigt den verwendeten Aufbau mit dem Koordinatensystem. Der Ursprung dieses Aufbaus befindet sich am ersten kinematischen Kettenelement, wo sich auch die Quelle befindet. Die Quelle ist mit dem ersten kinematischen Element so verbunden, dass die relative Position der Quelle zur kinematischen Kette immer konstant ist. In den folgenden Unterabbildungen wurde das Koordinatensystem weggelassen. Die blauen Vektoren stellen die möglichen Posen für den detektierten MV dar. Die hellgrüne Konstruktion zeigt die wahre Ausrichtung der kinematischen Kette. Der rote Vektor ist ein normalisierter Positionsvektor des Sensors, der auf die potentielle Pose in dieser Richtung zeigt. Der Sensor ist am zweiten Element angebracht. Er wird durch einen schwarzen gefüllten Kreis mit einem Vektor in die sensitive Richtung dargestellt. Unterabbildung\,(b) beginnt mit einer Elementausrichtung in $x$-Richtung. Für einige Iterationen sind die kinematische Kette und der zugehörige Positionsvektor dargestellt. Nach 15 Iterationen (Unterabbildung\,(d)) stimmt die Sensorpose mit einer potentiellen Pose überein und der Algorithmus konvergiert.}}{40}{figure.caption.65}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.12}{\ignorespaces Winkelfehler in Abhängigkeit der Iteration: Es sind die Verläufe für verschiedene $Q$ dargestellt. Dabei steigt die Konvergenzgeschwindigkeit wenn $Q$ kleiner wird. }}{41}{figure.caption.66}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.13}{\ignorespaces Beschreibung der zwei Freiheitsgrade: In der linken Abbildung ist eine kinematische Kette, bestehend aus zwei Elementen, mit einer 3D-Spule und einem 1D-Sensor, zu sehen. Das erste Element ist entlang der $y$-Achse ausgerichtet. Das zweite Element ist in der $yz$-Ebene ausgerichtet. In gelb ist $\vec {e}_{\textrm {\footnotesize \add@extra@listi {ftns}{max}}}$ dargestellt. Dieser spannt gemeinsam mit $\vec {r}_{\textrm {\footnotesize \add@extra@listi {ftns}{j}}}$ die gelbe ($yz$-)Ebene auf. In der Ebene liegen $\vec {r}_{\textrm {\footnotesize \add@extra@listi {ftns}{j}}}$, $\vec {e}_{\textrm {\footnotesize \add@extra@listi {ftns}{max}}}$ und $\vec {e}_{\textrm {\footnotesize \add@extra@listi {ftns}{s}}}$. In der rechten Abbildung ist der gelbe Ebenenschnitt dargestellt. In gelb ist die zweite Eingangsgröße $\phi _{\textrm {\footnotesize \add@extra@listi {ftns}{m,2}}}$ dargestellt. Der blaue Winkel zeigt die Ausgangsgröße $\phi _{\textrm {\footnotesize \add@extra@listi {ftns}{s,2}}}$.}}{41}{figure.caption.69}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.14}{\ignorespaces Funktionaler Winkelzusammenhang: In der Abbildung ist der Zusammenhang zwischen $\phi _{\textrm {\footnotesize \add@extra@listi {ftns}{s,2}}}$ und $\phi _{\textrm {\footnotesize \add@extra@listi {ftns}{m,2}}}$ für verschiedene Wertebereiche von $Q$. Die Abbildungen \ref {fig:0_05_Unique} und \ref {fig:bigger1_unique} zeigen eine eindeutige Zuordnung zwischen $\phi _{\textrm {\footnotesize \add@extra@listi {ftns}{s,2}}}$ und $\phi _{\textrm {\footnotesize \add@extra@listi {ftns}{m,2}}}$. In diesem Bereich gibt es für jeden Eingangsvektor einen zugehörigen Ausgangsvektor. In Abbildung \ref {fig:05_10_unique} ist der Zusammenhang für $0.5 < Q \leq 1$ zu sehen. Hier sind teilweise einem Wert für $\phi _{\textrm {\footnotesize \add@extra@listi {ftns}{m,2}}}$ zwei unterschiedliche Werte für $\phi _{\textrm {\footnotesize \add@extra@listi {ftns}{s,2}}}$ zugeordnet.}}{42}{figure.caption.70}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.15}{\ignorespaces Winkelfehler für $Q=1$: Der Winkelfehler ist in Abhängigkeit der Iteration dargestellt.}}{43}{figure.caption.71}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\nonumberline Korrektur von Modellfehlern}{43}{subsubsection*.73}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.16}{\ignorespaces Korrektur der Fingerdicke: Die Abbildung zeigt beispielhaft wie die Korrektur durchgeführt wird. Die linke Abbildung zeigt einmal ein kinematisches Element in der Nulllage (oben) und einmal in gebeugter Stellung (unten). Der Gelenksmittelpunkt (rot) wird auf die Oberfläche des Elements verschoben. In der gebeugten Haltung verändert sich die Distanz zwischen Sensor (orange) und Gelenk, sowie die Gelenksposition. Die Veränderung $l_{\textrm {\footnotesize \add@extra@listi {ftns}{z}}}$ ist in hellblau dargestellt. Dies ist vergrößert in der rechten Abbildung dargestellt, mit dem Beugungswinkel $\phi _{\textrm {\footnotesize \add@extra@listi {ftns}{B}}}$ (blau), der gleich dem Winkel in der Mitte des Gelenks ist. Die rote Länge ist die halbe Dicke $d_{\textrm {\footnotesize \add@extra@listi {ftns}{e}}}$ des kinematischen Elements.}}{44}{figure.caption.74}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\nonumberline Laufzeitoptimierung}{45}{subsubsection*.76}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4.1}{\ignorespaces Benötigte Zeit für die Ausführung von einer Million der aufgeführten Operationen. In der rechten Zeile werden die Zeitaufwände auf die Basis Operation Addition/Subtraktion normiert. In Blau ist der Aufwand für eine Iteration des Algorithmus hervorgehoben.}}{45}{table.caption.77}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3.2}Lokalisierung einer 3D-Spule}{46}{subsection.4.3.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\nonumberline Grundsätzliche Gedanken}{46}{subsubsection*.79}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\nonumberline Positionsschätzung}{46}{subsubsection*.81}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.17}{\ignorespaces Äquibetragsflächen mit zugehöriger Schnittkurve: Die Abbildung zeigt zwei Äquibetragsflächen, diese sind in rot/blau dargestellt. Die beiden Flächen schneiden sich, dies ist mit der gelben Schnittkurve dargestellt. }}{47}{figure.caption.82}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.18}{\ignorespaces Bestimmung des Schnittpunkts: (a) zeigt die Kurven und die geschätzten Positionen für die jeweilige Iteration. Rot gehört jeweils zu Sensor 1 und Blau zu Sensor 2. Nach der ersten Iteration wird der rote und blaue Punkt korrigiert. Mit jeder Iteration sinkt die Distanz zwischen $\hat {\vec {r}}_{\textrm {\footnotesize \add@extra@listi {ftns}{Q,1}}}^{\, i}$ und $\hat {\vec {r}}_{\textrm {\footnotesize \add@extra@listi {ftns}{Q,2}}}^{\, i}$. In (d) liegen dann beide Punkte nahezu übereinander und der Schnittpunkt wurde gefunden.}}{48}{figure.caption.83}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.19}{\ignorespaces Ausnahmebehandlung: Die Abbildung zeigt den Fehlerfall, wenn die Kurven sich nicht schneiden. In diesem Fall wird die grüne Position als Ergebnis genommen.}}{49}{figure.caption.84}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\nonumberline Orientierungsschätzung}{49}{subsubsection*.86}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.20}{\ignorespaces Beispiel für eine um 90° um die Z-Achse verdrehte Spule: Abbildung\,(a) zeigt die MVs berechnet anhand der geschätzten Position, in\,(b) sind die aus dem Signal extrahierten MVs dargestellt. Dabei ist gut zu erkennen, dass beide Abbildungen kongruent sind, jedoch um 90° verdreht. In Abbildung\,(c) sind die berechneten MVs mit einer gedrehten Ansicht dargestellt.}}{51}{figure.caption.87}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3.3}Kombination der Lokalisierungsalgorithmen}{52}{subsection.4.3.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.21}{\ignorespaces Übersicht des Lokalisierungsalgorithmus: Die Eingangsgröße sind die MVs aller Sensoren. Im oberen Teil ist die absolute Lokalisierung schematische dargestellt. Zunächst wird aus den MVs die Position der 3D-Spule bestimmt. Im Orientierungsschätzungsmodul werden aus der Position und den MVs die Orientierung der Spule bestimmt. Im unteren Teil ist die Schätzung einer kinematischen Kette, dieser schätzt aus den MVs die Haltung dieser. Die absolute Position und die Orientierungen der kinetmatischen Elemente werden dann von einem Kombinationsmodul kombiniert und ausgegeben.}}{53}{figure.caption.88}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4.4}Nachverarbeitung}{53}{section.4.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.22}{\ignorespaces Distanz zu Winkel: Die Abbildung zeigt eine kinematische Kette mit zwei Elementen. Auf dem ersten Element (unten) ist ein Akktuator angebracht, auf dem zweiten ein Sensor(orange). In gelb ist ein Dreieck eingezeichnet mit den zugehörigen Längen.}}{54}{figure.caption.91}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4.1}Schätzung einer kinematischen Kette}{54}{subsection.4.4.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\nonumberline Einbeziehung der Distanzinformation}{54}{subsubsection*.90}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.23}{\ignorespaces Vergleich der unterschiedlichen Berechnungsmethoden für $\phi _{\textrm {\footnotesize \add@extra@listi {ftns}{s,2}}}$: Gelb zeigt den wahren Wert, Orange den aus dem vorgestellten Algorithmus und Blau den aus der Distanz bestimmten Wert.}}{55}{figure.caption.92}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\nonumberline Glättung und Winkelumrechnung}{55}{subsubsection*.94}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.24}{\ignorespaces Filter für die Nachverarbeitung: Die Abbildung zeigt den Frequenzgang eines Butterworth-Tiefpassfilter fünfter Ordnung mit einer Grenzfrequenz von 8\,Hz.}}{56}{figure.caption.95}\protected@file@percent }
