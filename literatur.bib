	keywords = {electrostatic potential, nonlocal effects, nonlocal gravity, Poisson equation, resonant structures, variational method},
	pages = {1833},
	file = {Full Text PDF:C\:\\Users\\tsc\\Zotero\\storage\\ABZQJZT2\\Pinheiro - 2024 - Extended Field Interactions in Poisson{\textquoteright}s Equation Revision.pdf:application/pdf},
}

