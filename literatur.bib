Das Prozessrauschen Q wird adaptiv abhängig von der beschleunigung gesteuert. Das Messreauschen R wird auch abhängig von der Beschleunigung gemacht
},
	file = {IEEE Xplore Abstract Record:C\:\\Users\\tsc\\Zotero\\storage\\9JM2FS69\\5687273.html:text/html;IEEE Xplore Full Text PDF:C\:\\Users\\tsc\\Zotero\\storage\\936YLURR\\Asaari und Suandi - 2010 - Hand gesture tracking system using Adaptive Kalman.pdf:application/pdf},
}

@article{santoni_magik_2021,
