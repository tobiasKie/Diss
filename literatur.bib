	keywords = {Educational institutions, Accelerometers, Magnetometers, Calibration, Accuracy, Sensor phenomena and characterization},
	pages = {2100--2105},
	file = {Full Text PDF:C\:\\Users\\tsc\\Zotero\\storage\\23JC47US\\Kong et al. - 2013 - Development of a real-time IMU-based motion captur.pdf:application/pdf},
}

