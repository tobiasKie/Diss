@article{eggert_estimating_1997,
	title = {Estimating 3-{D} rigid body transformations: a comparison of four major algorithms},
	volume = {9},
	issn = {1432-1769},
	shorttitle = {Estimating 3-{D} rigid body transformations},
	url = {https://doi.org/10.1007/s001380050048},
	doi = {10.1007/s001380050048},
	abstract = {A common need in machine vision is to compute the 3-D rigid body transformation that aligns two sets of points for which correspondence is known. A comparative analysis is presented here of four popular and efficient algorithms, each of which computes the translational and rotational components of the transform in closed form, as the solution to a least squares formulation of the problem. They differ in terms of the transformation representation used and the mathematical derivation of the solution, using respectively singular value decomposition or eigensystem computation based on the standard \$[ {\textbackslash}vec\{R\}, {\textbackslash}vec\{T\} ]\$representation, and the eigensystem analysis of matrices derived from unit and dual quaternion forms of the transform. This comparison presents both qualitative and quantitative results of several experiments designed to determine (1) the accuracy and robustness of each algorithm in the presence of different levels of noise, (2) the stability with respect to degenerate data sets, and (3) relative computation time of each approach under different conditions. The results indicate that under {\textquotedblleft}ideal{\textquotedblright} data conditions (no noise) certain distinctions in accuracy and stability can be seen. But for {\textquotedblleft}typical, real-world{\textquotedblright} noise levels, there is no difference in the robustness of the final solutions (contrary to certain previously published results). Efficiency, in terms of execution time, is found to be highly dependent on the computer system setup.},
	language = {en},
	number = {5},
	urldate = {2025-08-07},
	journal = {Machine Vision and Applications},
	author = {Eggert, D.W. and Lorusso, A. and Fisher, R.B.},
	month = mar,
	year = {1997},
	keywords = {3-D Image Reconstruction, Algorithms, Computational Solid Mechanics, Key words:Motion analysis {\textendash} 3-D rigid transformations {\textendash} Pose estimation, Linear Algebra, Multibody Systems and Mechanical Vibrations, Transformation Optics},
	pages = {272--290},
	file = {Full Text PDF:C\:\\Users\\tsc\\Zotero\\storage\\DARHIZ34\\Eggert et al. - 1997 - Estimating 3-D rigid body transformations a comparison of four major algorithms.pdf:application/pdf},
}

