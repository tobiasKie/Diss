\@writefile{lof}{\contentsline {figure}{\numberline {4.1}{\ignorespaces Überblick der Signalverarbeitungspipeline: Auf der linken Seite kommen die Strom- und Magnetfeldsignale als Spannungen an und werden mit einem AD-Wandler mit einer konstanten Abtastrate digitalisiert. Diese Signale werden zunächst in der Vorverarbeitung entzerrt und gefiltert. Die gefilterten Signale werden genutzt um spezifische Merkmale zu extrahieren. Die Merkmale werden an die Lokalisierung gegeben. Diese schätzen Positionen und Orientierungen und geben diese an die Nachverarbeitung weiter. Die geschätzten Positionen und Orientierungen können dann von beliebigen Anwendungen verwendet werden.}}{27}{figure.caption.41}\protected@file@percent }
\newlabel{fig:OverviewSigPipe}{{4.1}{27}{Überblick der Signalverarbeitungspipeline: Auf der linken Seite kommen die Strom- und Magnetfeldsignale als Spannungen an und werden mit einem AD-Wandler mit einer konstanten Abtastrate digitalisiert. Diese Signale werden zunächst in der Vorverarbeitung entzerrt und gefiltert. Die gefilterten Signale werden genutzt um spezifische Merkmale zu extrahieren. Die Merkmale werden an die Lokalisierung gegeben. Diese schätzen Positionen und Orientierungen und geben diese an die Nachverarbeitung weiter. Die geschätzten Positionen und Orientierungen können dann von beliebigen Anwendungen verwendet werden}{figure.caption.41}{}}
\BKM@entry{id=32,open,dest={73656374696F6E2E342E31},srcline={21}}{5C3337365C3337375C303030565C3030306F5C303030725C303030765C303030655C303030725C303030615C303030725C303030625C303030655C303030695C303030745C303030755C3030306E5C30303067}
\@writefile{toc}{\contentsline {section}{\numberline {4.1}Vorverarbeitung}{28}{section.4.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces Übertragunsmechanismus: Eine Spannungsquelle erzeugt einen Strom durch die 3D-Spule. Die 3D-Spule erzeugt ein Magnetfeld, das von einem Fluxgatemagnetometer aufgenommen, in eine Spannung gewandelt und vom AD-Wandler digitalisiert. Der Spulenstrom kann als Spannungsabfall über $R_{\textrm  {\footnotesize  \add@extra@listi {ftns}{s}}}$ vom AD-Wandler gemessen werden.}}{28}{figure.caption.42}\protected@file@percent }
\newlabel{fig:GrundEntzerr}{{4.2}{28}{Übertragunsmechanismus: Eine Spannungsquelle erzeugt einen Strom durch die 3D-Spule. Die 3D-Spule erzeugt ein Magnetfeld, das von einem Fluxgatemagnetometer aufgenommen, in eine Spannung gewandelt und vom AD-Wandler digitalisiert. Der Spulenstrom kann als Spannungsabfall über $R\tindex {s}$ vom AD-Wandler gemessen werden}{figure.caption.42}{}}
\newlabel{fig:Tiefpass}{{4.3a}{30}{Tiefpassfilter\caption@thelabel }{figure.caption.43}{}}
\newlabel{fig:Bandpass}{{4.3b}{30}{Bandpassfilter\caption@thelabel }{figure.caption.43}{}}
