\newlabel{sub@fig:OptCoord}{{b}{62}{Optisches Koordinatensystem\caption@thelabel }{figure.caption.121}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.6}{\ignorespaces Definition der Koordinatensysteme: Der rote Pfeil ist jeweils die $x$-Asches, grün die $y$-Achse und blau die $z-Achse$. In \subref  {fig:MagCoord} ist eine 3D-Spule mit einem 3D-Druckaufsatz, an dem optische Marker befestigt sind. Mit den farbigen Pfeilen ist das lokale Koordinatensystem der Spule dargestellt. In \subref  {fig:OptCoord} ist der Kalibrierungsaufbau dargestellt. Während der Kalibrierung wird die Platte mit den Markern in der Mitte des Messvolumens platziert. Währenddessen wird dann der Stab mit den zwei Markern durch den Messbereich bewegt. Die Lage und Orientierung der Platte während der Kalibrierung definiert dann die Orientierung des optischen Koordinatensystem.}}{62}{figure.caption.121}\protected@file@percent }
\newlabel{fig:CoordSystems}{{5.6}{62}{Definition der Koordinatensysteme: Der rote Pfeil ist jeweils die $x$-Asches, grün die $y$-Achse und blau die $z-Achse$. In \subref {fig:MagCoord} ist eine 3D-Spule mit einem 3D-Druckaufsatz, an dem optische Marker befestigt sind. Mit den farbigen Pfeilen ist das lokale Koordinatensystem der Spule dargestellt. In \subref {fig:OptCoord} ist der Kalibrierungsaufbau dargestellt. Während der Kalibrierung wird die Platte mit den Markern in der Mitte des Messvolumens platziert. Währenddessen wird dann der Stab mit den zwei Markern durch den Messbereich bewegt. Die Lage und Orientierung der Platte während der Kalibrierung definiert dann die Orientierung des optischen Koordinatensystem}{figure.caption.121}{}}
\@writefile{toc}{\contentsline {subsubsection}{\nonumberline Kalibrierung}{62}{subsubsection*.123}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5.7}{\ignorespaces Kalibrierung der kinematischen Kette: Die Abbildung zeigt eine kinematische Kette bestehend aus drei Elementen. Die Roten Pfeile zeigen alle Größen die für den Algorithmus vor der Laufzeit bestimmt werden müssen.}}{63}{figure.caption.124}\protected@file@percent }
