\@writefile{lof}{\contentsline {figure}{\numberline {4.9}{\ignorespaces Sensor- und Quellenanordnung: Die kinematische Kette besteht aus zylinderförmigen Element, sowie Gelenken die diese verbinden und die Möglichkeit haben diese zu bewegen. Die linke Seite zeigt die Anordnung der Quellen und Sensoren auf der kinematischen Kette. Auf dem ersten Element ist eine 3D-Spule angebracht. Die weiteren Elemente sind mit Sensoren ausgerüstet. Diese sind auf der Mittelachse des kinematischen Elements, außerdem ist die sensitive Achse des Sensors mit der Symetrieachse des Elements ausgerichtet (siehe rechter Teil). }}{38}{figure.caption.55}\protected@file@percent }
\newlabel{fig:Sensorplacement}{{4.9}{38}{Sensor- und Quellenanordnung: Die kinematische Kette besteht aus zylinderförmigen Element, sowie Gelenken die diese verbinden und die Möglichkeit haben diese zu bewegen. Die linke Seite zeigt die Anordnung der Quellen und Sensoren auf der kinematischen Kette. Auf dem ersten Element ist eine 3D-Spule angebracht. Die weiteren Elemente sind mit Sensoren ausgerüstet. Diese sind auf der Mittelachse des kinematischen Elements, außerdem ist die sensitive Achse des Sensors mit der Symetrieachse des Elements ausgerichtet (siehe rechter Teil)}{figure.caption.55}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.10}{\ignorespaces Flussdiagramm des iterativen Algorithmus: Der Algorithmus startet mit einer zufällig ausgewählten Sensororientierung. Im ersten Schritt wird die relative Sensorposition bestimmt. Daraus wird die zugehörige Sensororientierung bestimmt. Diese Prozedur wird wiederholt, bis die Veränderung zwischen den Iterationen kleiner ist als ein definierter Schwellenwert und Konvergenz erreicht ist. Diese Orientierung ist dann die geschätzte Lösung.}}{39}{figure.caption.58}\protected@file@percent }
\newlabel{fig:Flussdiagramm}{{4.10}{39}{Flussdiagramm des iterativen Algorithmus: Der Algorithmus startet mit einer zufällig ausgewählten Sensororientierung. Im ersten Schritt wird die relative Sensorposition bestimmt. Daraus wird die zugehörige Sensororientierung bestimmt. Diese Prozedur wird wiederholt, bis die Veränderung zwischen den Iterationen kleiner ist als ein definierter Schwellenwert und Konvergenz erreicht ist. Diese Orientierung ist dann die geschätzte Lösung}{figure.caption.58}{}}
\@writefile{toc}{\contentsline {subsubsection}{\nonumberline Eindeutigkeit der Lösung}{39}{subsubsection*.62}\protected@file@percent }
\newlabel{subsubsection:eindeutigkeit}{{4.3.1}{39}{Eindeutigkeit der Lösung}{subsubsection*.62}{}}
\newlabel{fig:legendKinChain}{{\caption@xref {fig:legendKinChain}{ on input line 371}}{40}{Iterativer Algorithmus}{figure.caption.59}{}}
\newlabel{fig:Setup}{{4.11a}{40}{Setup\caption@thelabel }{figure.caption.59}{}}
\newlabel{fig:Iteration1}{{4.11b}{40}{Iteration 1\caption@thelabel }{figure.caption.59}{}}
\newlabel{fig:Iteration2}{{4.11c}{40}{Iteration 2\caption@thelabel }{figure.caption.59}{}}
\newlabel{fig:Iteration15}{{4.11d}{40}{Iteration 15\caption@thelabel }{figure.caption.59}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.11}{\ignorespaces Beispielhafter iterativer Prozess: Die Abbildung zeigt die Iterationen für einen einfachen Aufbau. Die Unterabbildung (a) zeigt das Koordinatensystem. Der Ursprung dieses Aufbaus befindet sich am ersten kinematischen Kettenelement, wo sich auch die Quelle befindet. In den folgenden Unterabbildungen wurde das Koordinatensystem weggelassen. Die blauen Vektoren stellen die möglichen Posen für den detektierten MV dar. Die hellgrüne Konstruktion zeigt die wahre Ausrichtung der kinematischen Kette. Der rote Vektor ist ein normalisierter Positionsvektor des Sensors, der auf die potentielle Pose in dieser Richtung zeigt. Der Sensor ist am zweiten Element angebracht. Er wird durch einen orangenen gefüllten Kreis mit einem Vektor in die sensitive Richtung dargestellt. Unterabbildung\,(b) beginnt mit einer Elementausrichtung in $x$-Richtung. Für einige Iterationen sind die kinematische Kette und der zugehörige Positionsvektor dargestellt. Nach 15 Iterationen (Unterabbildung\,(d)) stimmt die Sensorpose mit einer potentiellen Pose überein und der Algorithmus konvergiert.}}{40}{figure.caption.59}\protected@file@percent }
\newlabel{fig:Concept_Algorithm}{{4.11}{40}{Beispielhafter iterativer Prozess: Die Abbildung zeigt die Iterationen für einen einfachen Aufbau. Die Unterabbildung (a) zeigt das Koordinatensystem. Der Ursprung dieses Aufbaus befindet sich am ersten kinematischen Kettenelement, wo sich auch die Quelle befindet. In den folgenden Unterabbildungen wurde das Koordinatensystem weggelassen. Die blauen Vektoren stellen die möglichen Posen für den detektierten MV dar. Die hellgrüne Konstruktion zeigt die wahre Ausrichtung der kinematischen Kette. Der rote Vektor ist ein normalisierter Positionsvektor des Sensors, der auf die potentielle Pose in dieser Richtung zeigt. Der Sensor ist am zweiten Element angebracht. Er wird durch einen orangenen gefüllten Kreis mit einem Vektor in die sensitive Richtung dargestellt. Unterabbildung\,(b) beginnt mit einer Elementausrichtung in $x$-Richtung. Für einige Iterationen sind die kinematische Kette und der zugehörige Positionsvektor dargestellt. Nach 15 Iterationen (Unterabbildung\,(d)) stimmt die Sensorpose mit einer potentiellen Pose überein und der Algorithmus konvergiert}{figure.caption.59}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.12}{\ignorespaces Winkelfehler in Abhängigkeit der Iteration: Es sind die Verläufe für verschiedene $Q$ dargestellt. Dabei steigt die Konvergenzgeschwindigkeit wenn $Q$ kleiner wird. }}{41}{figure.caption.60}\protected@file@percent }
\newlabel{fig:ConvergenceSpeed}{{4.12}{41}{Winkelfehler in Abhängigkeit der Iteration: Es sind die Verläufe für verschiedene $Q$ dargestellt. Dabei steigt die Konvergenzgeschwindigkeit wenn $Q$ kleiner wird}{figure.caption.60}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.13}{\ignorespaces  Beschreibung der zwei Freiheitsgrade: In der linken Abbildung ist eine kinematische Kette, bestehend aus zwei Elementen, mit einer 3D-Spule und einem 1D-Sensor, zu sehen. Das erste Element ist entlang der $y$-Achse ausgerichtet. Das zweite Element ist in der $yz$-Ebene ausgerichtet. In gelb ist $\vec  {e}_{\textrm  {\footnotesize  \add@extra@listi {ftns}{max}}}$ dargestellt. Dieser spannt gemeinsam mit $\vec  {r}_{\textrm  {\footnotesize  \add@extra@listi {ftns}{j}}}$ die gelbe ($yz$-)Ebene auf. In der Ebene liegen $\vec  {r}_{\textrm  {\footnotesize  \add@extra@listi {ftns}{j}}}$, $\vec  {e}_{\textrm  {\footnotesize  \add@extra@listi {ftns}{max}}}$ und $\vec  {e}_{\textrm  {\footnotesize  \add@extra@listi {ftns}{s}}}$. In der rechten Abbildung ist der gelbe Ebenenschnitt dargestellt. In gelb ist die zweite Eingangsgröße $\phi _{\textrm  {\footnotesize  \add@extra@listi {ftns}{max,2}}}$ dargestellt. Der blaue Winkel zeigt die Ausgangsgröße $\phi _{\textrm  {\footnotesize  \add@extra@listi {ftns}{s,2}}}$.}}{41}{figure.caption.63}\protected@file@percent }
\newlabel{fig:Visualisierung_Uniqueness_Ebene}{{4.13}{41}{Beschreibung der zwei Freiheitsgrade: In der linken Abbildung ist eine kinematische Kette, bestehend aus zwei Elementen, mit einer 3D-Spule und einem 1D-Sensor, zu sehen. Das erste Element ist entlang der $y$-Achse ausgerichtet. Das zweite Element ist in der $yz$-Ebene ausgerichtet. In gelb ist $\vec {e}\tindex {max}$ dargestellt. Dieser spannt gemeinsam mit $\vec {r}\tindex {j}$ die gelbe ($yz$-)Ebene auf. In der Ebene liegen $\vec {r}\tindex {j}$, $\vec {e}\tindex {max}$ und $\vec {e}\tindex {s}$. In der rechten Abbildung ist der gelbe Ebenenschnitt dargestellt. In gelb ist die zweite Eingangsgröße $\phi \tindex {max,2}$ dargestellt. Der blaue Winkel zeigt die Ausgangsgröße $\phi \tindex {s,2}$}{figure.caption.63}{}}
\newlabel{fig:0_05_Unique}{{4.14a}{42}{$0<Q\leq 0.5$}{figure.caption.64}{}}
\newlabel{sub@fig:0_05_Unique}{{a}{42}{$0<Q\leq 0.5$}{figure.caption.64}{}}
\newlabel{fig:05_10_unique}{{4.14b}{42}{$0.5<Q\leq 1$}{figure.caption.64}{}}
\newlabel{sub@fig:05_10_unique}{{b}{42}{$0.5<Q\leq 1$}{figure.caption.64}{}}
\newlabel{fig:bigger1_unique}{{4.14c}{42}{$1<Q$}{figure.caption.64}{}}
\newlabel{sub@fig:bigger1_unique}{{c}{42}{$1<Q$}{figure.caption.64}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.14}{\ignorespaces  Funktionaler Winkelzusammenhang: In der Abbildung ist der Zusammenhang zwischen $\phi _{\textrm  {\footnotesize  \add@extra@listi {ftns}{s,2}}}$ und $\phi _{\textrm  {\footnotesize  \add@extra@listi {ftns}{max,2}}}$ für verschiedene Wertebereiche von $Q$ dargestellt. Die Abbildungen \ref {fig:0_05_Unique} und \ref {fig:bigger1_unique} zeigen eine eindeutige Zuordnung zwischen $\phi _{\textrm  {\footnotesize  \add@extra@listi {ftns}{s,2}}}$ und $\phi _{\textrm  {\footnotesize  \add@extra@listi {ftns}{max,2}}}$. In diesem Bereich gibt es für jeden Eingangsvektor einen zugehörigen Ausgangsvektor. In Abbildung \ref {fig:05_10_unique} ist der Zusammenhang für $0.5 < Q \leq 1$ zu sehen. Hier sind teilweise einem Wert für $\phi _{\textrm  {\footnotesize  \add@extra@listi {ftns}{max,2}}}$ zwei unterschiedliche Werte für $\phi _{\textrm  {\footnotesize  \add@extra@listi {ftns}{s,2}}}$ zugeordnet.}}{42}{figure.caption.64}\protected@file@percent }
\newlabel{fig:uniqueness}{{4.14}{42}{Funktionaler Winkelzusammenhang: In der Abbildung ist der Zusammenhang zwischen $\phi \tindex {s,2}$ und $\phi \tindex {max,2}$ für verschiedene Wertebereiche von $Q$ dargestellt. Die Abbildungen \ref {fig:0_05_Unique} und \ref {fig:bigger1_unique} zeigen eine eindeutige Zuordnung zwischen $\phi \tindex {s,2}$ und $\phi \tindex {max,2}$. In diesem Bereich gibt es für jeden Eingangsvektor einen zugehörigen Ausgangsvektor. In Abbildung \ref {fig:05_10_unique} ist der Zusammenhang für $0.5 < Q \leq 1$ zu sehen. Hier sind teilweise einem Wert für $\phi \tindex {max,2}$ zwei unterschiedliche Werte für $\phi \tindex {s,2}$ zugeordnet}{figure.caption.64}{}}
\newlabel{eq:uniqness_Value_2}{{4.33}{42}{Eindeutigkeit der Lösung}{equation.4.33}{}}
