\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces Signalerzeugung: Eine Spannungsquelle erzeugt einen Strom durch die 3D-Spule und durch $R_{\textrm  {\footnotesize  \add@extra@listi {ftns}{s}}}$. Die 3D-Spule erzeugt ein Magnetfeld, dass von einem Fluxgatemagnetometer aufgenommen, in eine Spannung gewandelt und an den AD-Wandler weitergegeben wird. Der erzeugte Strom fließt über $R_{\textrm  {\footnotesize  \add@extra@listi {ftns}{s}}}$ zurück und die abgefallene Spannung wird abgegriffen und an den AD-Wandler gegeben. Der Vorgang ist im unteren Teil der Abbildung schematisch dargestellt.}}{28}{figure.caption.47}\protected@file@percent }
\newlabel{fig:GrundEntzerr}{{4.2}{28}{Signalerzeugung: Eine Spannungsquelle erzeugt einen Strom durch die 3D-Spule und durch $R\tindex {s}$. Die 3D-Spule erzeugt ein Magnetfeld, dass von einem Fluxgatemagnetometer aufgenommen, in eine Spannung gewandelt und an den AD-Wandler weitergegeben wird. Der erzeugte Strom fließt über $R\tindex {s}$ zurück und die abgefallene Spannung wird abgegriffen und an den AD-Wandler gegeben. Der Vorgang ist im unteren Teil der Abbildung schematisch dargestellt}{figure.caption.47}{}}
